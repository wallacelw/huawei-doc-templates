%% huawei-page.sty
%% =====================================================================
%%  Page layout: caption setup, float placement defaults, hyperref config,
%%  header/footer (fancyhdr), and \startbody command.
%%  Extracted from guide.cls v2.0.0 decomposition.
%% =====================================================================
\ProvidesPackage{huawei-page}[2026/08/19 Huawei page layout]
%% Depends on: huawei-colors (linkblue), huawei-lang (\lg@pagelabel)

% =====================================================================
%  CAPTION SETUP
% =====================================================================
\captionsetup[figure]{font={small}, labelfont=bf, labelsep=colon}
\captionsetup[table]{font={small}, labelfont=bf, labelsep=colon}

% Float placement: force [H] (here, exactly) as the default for figure and
% table floats so they appear in source order and never drift to a later page.
% Requires the float package, which defines the H specifier.  Users can still
% override a single float with an explicit [h], [t], [b], or [p].
\renewcommand{\fps@figure}{H}
\renewcommand{\fps@table}{H}

% =====================================================================
%  HYPERREF  (blue links, no underline)
% =====================================================================
\hypersetup{
  colorlinks=true,
  linkcolor=black,      % internal links (TOC) in black
  urlcolor=linkblue,
  citecolor=linkblue,
  linktoc=all,
  bookmarksnumbered=true,
}
% Set PDF metadata after preamble (title is set by \setdoctitle)
\AtBeginDocument{\hypersetup{pdftitle={\lg@doctitle}, pdfauthor={Huawei Technologies}}}

% =====================================================================
%  HEADER AND FOOTER
% =====================================================================
% Configurable header title: \setheadertitle{...}
\newcommand{\lg@headertitle}{Huawei Cloud}
\newcommand{\setheadertitle}[1]{\renewcommand{\lg@headertitle}{#1}}
\newcommand{\lg@headerlogo}{common-assets/huawei-logo-header.png}
\newcommand{\setheaderlogo}[1]{\renewcommand{\lg@headerlogo}{#1}}
% Extra logos (multi-logo support): up to two additional logos rendered in
% the page header right corner and on the cover row.  The state lives here
% because huawei-page loads BEFORE huawei-cover; huawei-cover.sty consumes
% \lg@extralogoi / \lg@extralogoii in \lg@coverlogorow.
\newcommand{\lg@extralogoi}{}
\newcommand{\setextralogoi}[1]{\renewcommand{\lg@extralogoi}{#1}}
\newcommand{\lg@extralogoii}{}
\newcommand{\setextralogoii}[1]{\renewcommand{\lg@extralogoii}{#1}}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
% Header: logo (left) + title (center) + extra logos (right)
% Footer: "Page N" (center)
% Header logo box: render the logo only if the file exists.  A missing logo
% is a compile-time warning, not a hard error — the header falls back to
% text only (same graceful behavior as \lg@checkimg for content images).
\newcommand{\lg@headerlogowarn}{%
  \typeout{Warning: header logo not found — header text only}%
  \global\let\lg@headerlogowarn\relax}
\newcommand{\lg@headerlogobox}{%
  \IfFileExists{\lg@headerlogo}{%
    \raisebox{-0.35cm}[0pt][0pt]{\includegraphics[height=1.05cm]{\lg@headerlogo}}%
  }{%
    \lg@headerlogowarn
  }}
% Header extra-logo box: render the extra logos side by side in the header
% right corner, 0.25cm apart.  Unset logos render nothing (default docs are
% unchanged); a missing file is a one-time compile-time warning, not a hard
% error (same graceful behavior as \lg@headerlogobox above).
\newcommand{\lg@headerextrawarn}{%
  \typeout{Warning: extra header logo not found — skipped}%
  \global\let\lg@headerextrawarn\relax}
\newcommand{\lg@headerextrabox}{%
  \ifdefempty{\lg@extralogoi}{}{%
    \IfFileExists{\lg@extralogoi}{%
      \raisebox{-0.35cm}[0pt][0pt]{\includegraphics[height=1.05cm]{\lg@extralogoi}}%
    }{%
      \lg@headerextrawarn
    }%
  }%
  \ifdefempty{\lg@extralogoii}{}{%
    \ifdefempty{\lg@extralogoi}{}{\IfFileExists{\lg@extralogoi}{\hspace{0.25cm}}{}}%
    \IfFileExists{\lg@extralogoii}{%
      \raisebox{-0.35cm}[0pt][0pt]{\includegraphics[height=1.05cm]{\lg@extralogoii}}%
    }{%
      \lg@headerextrawarn
    }%
  }%
}
\fancyhead[L]{\lg@headerlogobox}
\fancyhead[C]{\normalfont\fontsize{10}{12}\selectfont \lg@headertitle}
\fancyhead[R]{\lg@headerextrabox}
\fancyfoot[C]{\normalfont\fontsize{10}{12}\selectfont \lg@pagelabel~\thepage}

% Plain style: no header, page number in footer (for TOC, changelog)
\fancypagestyle{plain}{
  \fancyhf{}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
  \fancyfoot[C]{\normalfont\fontsize{10}{12}\selectfont \lg@pagelabel~\thepage}
}

% =====================================================================
%  BODY — resets page numbering
% =====================================================================
\newcommand{\startbody}{\clearpage\pagenumbering{arabic}\pagestyle{fancy}\thispagestyle{fancy}}

\endinput
