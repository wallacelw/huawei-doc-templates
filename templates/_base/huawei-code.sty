%% huawei-code.sty
%% =====================================================================
%%  Code environments and commands: code, codefile, inlinecode, param.
%%  Extracted from guide.cls v2.0.0 decomposition.
%% =====================================================================
\ProvidesPackage{huawei-code}[2026/08/20 Huawei code formatting]
%% Depends on: huawei-fonts (\codefont), huawei-colors (codebg, codetext), keyval (\define@key)

% =====================================================================
%  CODE  (fancyvrb + fvextra — clean PDF copy-paste)
% =====================================================================
% No-op keys for language hints ([bash], [python], etc.) — ignored,
% kept for backward compatibility with existing documents.
\newcommand{\lg@deflangkey}[1]{\define@key{FV}{#1}[unused]{}}
\forcsvlist{\lg@deflangkey}{bash,sh,shell,python,Python,json,yaml,xml,html,javascript,js,sql,text,ini,conf}

% Catch-all for unknown language keys ([go], [java], [terraform], ...).
% The converter emits \begin{code}[<lang>] for any [source,<lang>]
% block, so the FV family must accept ANY key. keyval raises a hard
% error for undefined keys via \KV@errx; that handler is wrapped here
% so that, for the FV family only, an unknown key is skipped with a
% compile-time warning and the block falls back to plain verbatim
% styling (same as [text]). Every other keyval family (graphics,
% tcolorbox, ...) keeps keyval's original hard error, so typos in
% other packages' options are still caught. \KV@prefix holds
% "KV@<family>@" while keyval parses, and \@tempa holds the key name.
% Note: \def (not \newcommand) so the \ifx comparison matches keyval's
% non-\long \KV@prefix — \ifx distinguishes the \long prefix.
\def\lg@FV@prefix{KV@FV@}
\let\lg@KV@errx\KV@errx
\def\KV@errx#1{%
  \ifx\KV@prefix\lg@FV@prefix
    \PackageWarningNoLine{huawei-code}{Unknown language key '\@tempa' ignored.\MessageBreak
      Using plain verbatim styling (same as [text]). Define a no-op\MessageBreak
      key for it above to silence this warning.}%
  \else
    \lg@KV@errx{#1}%
  \fi}

% Code block: #F6F8FA background, subtle border, left indented
% Uses fancyvrb (not listings) for clean copy-paste in PDF.
% listings processes character by character -> xdvipdfmx writes each
% one as a separate text operation -> PDF readers insert spaces.
% fancyvrb typesets line by line -> contiguous text in PDF -> clean copy.

% Shared fancyvrb options for code blocks (used by code environment and \codefile).
\newcommand{\lg@codeopts}{fontsize=\fontsize{10}{13}\selectfont, formatcom=\codefont\color{codetext}, frame=single, framerule=0.4pt, rulecolor=\color{codeborder}, backgroundcolor=codebg, xleftmargin=0.7cm, xrightmargin=0.5cm, breaklines=true, breakanywhere=true, breakindent=1em, breaksymbolleft={}, breaksymbolright={}, breakanywheresymbolpre={}, breakanywheresymbolpost={}}

% Expand \lg@codeopts before passing to fancyvrb (key-value scanner
% requires pre-expanded options; macros are not expanded during scanning).
\def\lg@code@def{\DefineVerbatimEnvironment{code}{Verbatim}}
\expandafter\lg@code@def\expandafter{\lg@codeopts}

% Code block from external file
\newcommand{\codefile}[2][]{%
  \IfFileExists{#2}{%
    \expandafter\VerbatimInput\expandafter[\lg@codeopts]{#2}%
  }{\PackageWarning{huawei-code}{Code file "#2" not found.
    Check the path (relative to TEXINPUTS) and that the file exists.}}%
}

% Inline code: \inlinecode{...}
\newcommand{\inlinecode}[1]{{\codefont\fontsize{10}{12}\selectfont\color{codetext}#1}}
% File/parameter name in text (italic)
\newcommand{\param}[1]{\textit{#1}}

\endinput
