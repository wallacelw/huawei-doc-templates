.DS_Store
*.swp
# Multi-format output artifacts (generated by pandoc)
examples/guide/*/main.md
examples/guide/*/main.docx
examples/guide/*/main.html
examples/technical/*/main.md
examples/technical/*/main.docx
examples/technical/*/main.html
examples/setup-guide/setup-guide.md
examples/setup-guide/setup-guide.docx
examples/setup-guide/setup-guide.html
# User documents — ignore everything in documents/ except README.md
documents/*
!documents/README.md
__pycache__/
