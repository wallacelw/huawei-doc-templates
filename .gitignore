!documents/guide-pt/main.pdf
!documents/guide-en/main.pdf
!documents/setup-guide/setup-guide.pdf
!documents/technical-pt/main.pdf
!documents/technical-en/main.pdf
!documents/testbook-pt/main.pdf
!documents/testbook-en/main.pdf
# editor / os cruft
.DS_Store
*.swp
# Multi-format output artifacts (generated by pandoc)
documents/guide-*/main.md
documents/guide-*/main.docx
documents/guide-*/main.html
documents/technical-*/main.md
documents/technical-*/main.docx
documents/technical-*/main.html
documents/testbook-*/main.md
documents/testbook-*/main.docx
documents/testbook-*/main.html
documents/poc-*/main.md
documents/poc-*/main.docx
documents/poc-*/main.html
documents/setup-guide/setup-guide.md
documents/setup-guide/setup-guide.docx
documents/setup-guide/setup-guide.html
# Generated LaTeX from AsciiDoc (build artifacts, not source)
documents/*/src/main.tex
documents/*/src/setup-guide.tex
# Generated diagram images (build artifacts from asciidoctor-diagram)
documents/*/src/sequence*.png
documents/*/src/flowchart*.png
documents/*/src/mermaid*.png
documents/*/src/diagrama*.png
documents/*/src/fluxograma*.png
documents/*/src/tech-*.png
documents/*/src/test-*.png
# Session files
session-*.md
# User documents — ignore everything in documents/ except README.md and sample dirs
documents/*
!documents/README.md
!documents/guide-pt/
!documents/guide-en/
!documents/technical-pt/
!documents/technical-en/
!documents/testbook-pt/
!documents/testbook-en/
!documents/poc-pt/
!documents/poc-en/
!documents/setup-guide/
__pycache__/
# Deepwork state (git-local, OpenCode-readable)
.slim/deepwork/
.asciidoctor/
templates/poc-scope/*.docx
