# compiled output (ignored by default)
*.pdf
# Keep sample and setup-guide PDFs for validation
!examples/guide/pt/main.pdf
!examples/guide/en/main.pdf
!examples/setup-guide/setup-guide.pdf
!examples/technical/pt/main.pdf
!examples/technical/en/main.pdf
!examples/testbook/pt/main.pdf
!examples/testbook/en/main.pdf
# Keep root setup-guide/ formats (pre-compiled for users to read)
!setup-guide/setup-guide.pdf
!setup-guide/setup-guide.md
!setup-guide/setup-guide.docx
!setup-guide/setup-guide.html
# editor / os cruft
.DS_Store
*.swp
# Multi-format output artifacts (generated by pandoc)
examples/guide/*/main.md
examples/guide/*/main.docx
examples/guide/*/main.html
examples/technical/*/main.md
examples/technical/*/main.docx
examples/technical/*/main.html
examples/testbook/*/main.md
examples/testbook/*/main.docx
examples/testbook/*/main.html
examples/setup-guide/setup-guide.md
examples/setup-guide/setup-guide.docx
examples/setup-guide/setup-guide.html
# Generated LaTeX from AsciiDoc (build artifacts, not source)
examples/*/src/main.tex
examples/*/src/setup-guide.tex
documents/*/src/main.tex
# User documents — ignore everything in documents/ except README.md
documents/*
!documents/README.md
__pycache__/
# Deepwork state (git-local, OpenCode-readable)
.slim/deepwork/
